# 本机 PostgreSQL；首次运行先创建 didi_development 数据库。
DATABASE_URL=postgresql://localhost:5432/didi_development?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
APP_ORIGIN=http://localhost:5173
SESSION_TTL=12h
READINESS_TIMEOUT=2s
SHUTDOWN_TIMEOUT=10s
# 测试库与开发库分离；每次集成/E2E 只创建并清理自己拥有的 schema。
TEST_DATABASE_URL=postgresql://localhost:5432/didi_test?sslmode=disable
# 本地演示占位符密码，可直接运行 pnpm demo / seed:users / seed:demo（8～72 字节）。
# 部署时替换为自己的密码；初始化不会重置已有账号密码。
SEED_ADMIN_PASSWORD=DidiAdmin123!
SEED_EDITOR_PASSWORD=DidiEditor123!
SEED_VIEWER_PASSWORD=DidiViewer123!
